# NER-LEWS Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Environment
ENVIRONMENT=development
IS_DEMO_MODE=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=landslide_ner.db

# API & Gateway Endpoints (Placeholders only - never commit production credentials)
WEATHER_API_KEY=your_open_meteo_or_imd_key_placeholder
MAP_API_KEY=your_mapbox_or_osm_key_placeholder
SMS_GATEWAY_URL=https://api.sms-gateway-placeholder.gov.in/v1/send
MODEL_PATH=ml/models/ensemble_weights.json

# Security & Tokens
SECRET_KEY=ner-lews-demo-insecure-secret-key-change-in-prod
